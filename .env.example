# Copy to .env and set a strong unique value. Never commit .env.
HOST=127.0.0.1
PORT=8443
DATA_DIR=./data
TLS_KEY=./certs/server-key.pem
TLS_CERT=./certs/server-cert.pem
ALLOW_REGISTRATION=true
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token
SESSION_TTL_HOURS=168
MAX_MESSAGE_LENGTH=4000
